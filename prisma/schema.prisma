// IndiGate — India × Japan Talent Platform
// Prisma schema (SQLite). Enums/arrays are stored as String/JSON and
// validated in the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         String   @default("CANDIDATE") // CANDIDATE | COMPANY | ADMIN
  name         String?
  isVerified   Boolean  @default(false)
  verifyToken  String?  @unique
  resetToken   String?  @unique
  resetTokenExp DateTime?
  // Google OAuth
  googleId     String?  @unique
  image        String?  // profile photo URL (Google or upload)
  // TOTP 2FA
  totpEnabled  Boolean  @default(false)
  totpSecret   String?
  backupCodes  String?  // JSON string array of hashed backup codes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate      CandidateProfile?
  company        CompanyProfile?
  notifications  Notification[]
  contactSubmissions ContactSubmission[]
  jobAlerts      JobAlert[]
}

model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  phone           String?
  bio             String?
  location        String?
  photoUrl        String?
  linkedinUrl     String?
  jlptLevel       String   @default("NONE") // N1|N2|N3|N4|N5|NONE
  skills          String   @default("[]") // JSON string array
  resumeUrl       String?
  resumeName      String?
  experienceYears Int      @default(0)
  education       String?  // JSON string
  savedJobIds     String   @default("[]") // JSON string array
  resumeData      String?  // JSON: full resume builder data (EN+JP)
  openToWork      Boolean  @default(true) // "Open to Work" toggle (LinkedIn-style)
  // Document verification (for visa process)
  docStatus       String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  passportUrl     String?  // passport scan
  jlptCertUrl     String?  // JLPT certificate
  degreeCertUrl   String?  // degree certificate
  docRejectReason String?  // reason if rejected
  docReviewedAt   DateTime?
  docReviewedBy   String?  // admin user ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications Application[]
  conversations Conversation[]
}

model CompanyProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  industry      String?
  locationJapan String?
  description   String?
  logoUrl       String?
  website       String?
  employeeCount String?
  isApproved    Boolean   @default(false)
  approvedAt    DateTime?
  // Company verification (business license, etc.)
  licenseUrl    String?   // business license / 営業許可証 upload
  regCertUrl    String?   // company registration certificate
  isVerified    Boolean   @default(false) // verified badge
  verifiedAt    DateTime?
  verifiedBy    String?   // admin user ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs Job[]
  conversations Conversation[]
}

model Job {
  id             String   @id @default(cuid())
  companyId      String
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  titleJa        String?
  description    String
  descriptionJa  String?
  location       String
  jobType        String   @default("FULL_TIME") // FULL_TIME|PART_TIME|INTERNSHIP|CONTRACT
  jlptRequired   String   @default("NONE") // N1|N2|N3|N4|N5|NONE
  salaryMin      Int?
  salaryMax      Int?
  salaryType     String   @default("MONTHLY") // HOURLY|MONTHLY|YEARLY
  currency       String   @default("JPY")
  skillsRequired String   @default("[]") // JSON string array
  isActive       Boolean  @default(true)
  deadline       DateTime?
  postedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications Application[]
  views         JobView[]
  conversations Conversation[]

  @@index([isActive, postedAt])
  @@index([companyId])
}

model Application {
  id                 String   @id @default(cuid())
  candidateId        String
  candidate          CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status             String   @default("APPLIED") // APPLIED|SHORTLISTED|INTERVIEWED|OFFERED|REJECTED|WITHDRAWN
  coverNote          String?
  resumeUrlSnapshot  String?
  notes              String?
  interviewDate      DateTime?
  interviewNotes     String?
  appliedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([candidateId, jobId])
  @@index([jobId])
  @@index([candidateId])
}

model JobView {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sessionId String   // anonymous session cookie ID
  viewedAt  DateTime @default(now())

  @@index([jobId])
  @@index([sessionId])
  @@index([viewedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  content   String
  contentJa String?
  photoUrl  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

/// Saved job search alert (LinkedIn-style). Candidates set criteria;
/// new matching jobs generate a notification.
model JobAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // user-facing label, e.g. "Tokyo N3 React jobs"
  search      String?  // search keyword
  location    String?  // location filter
  jobType     String?  // FULL_TIME | PART_TIME | INTERNSHIP | CONTRACT
  jlptLevel   String?  // N1|N2|N3|N4|N5|NONE
  salaryMin   Int?
  isActive    Boolean  @default(true)
  lastChecked DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// Audit log — tracks all admin actions for APPI compliance.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   // admin user ID
  actorEmail  String   // admin email (denormalized for quick display)
  action      String   // e.g. "APPROVE_COMPANY", "DELETE_USER", "VERIFY_CANDIDATE"
  targetType  String   // "User" | "Company" | "Candidate" | "Job" | "Application"
  targetId    String?  // ID of the affected entity
  targetName  String?  // human-readable name (e.g. company name, user email)
  details     String?  // JSON string with before/after values
  ipAddress   String?  // admin's IP address
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Conversation {
  id          String   @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId   String
  company     CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]

  @@unique([candidateId, companyId, jobId])
  @@index([candidateId])
  @@index([companyId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       // User.id
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}
